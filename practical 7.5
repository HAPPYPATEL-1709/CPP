#include <iostream>
#include <iomanip>

using namespace std;

int main() {
    const int numStudents = 4;  
    string studentNames[numStudents] = {"Happy", "Anjal", "Maitri", "Sneha"};
    int marks[numStudents] = {85, 92, 75, 88};
    double fees[numStudents] = {15000.75, 12000.50, 13500.00, 11000.25};  

    cout << left << setw(20) << "Student Name"
         << setw(10) << "Marks"
         << setw(15) << "Tuition Fees" << endl;
    cout << string(55, '-') << endl; 

    for (int i = 0; i < numStudents; ++i) {
        cout << left << setw(20) << studentNames[i]
             << setw(10) << marks[i]
             << setw(15) << "₹" << fixed << setprecision(2) << fees[i] << endl; 
    }

    return 0;
}
