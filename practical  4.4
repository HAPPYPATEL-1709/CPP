#include <iostream>
#include <string>
#define MAX_TRANSACTIONS 10  
class BankAccount {
protected:
    std::string accountNumber;
    double balance;
    std::string transactionHistory[MAX_TRANSACTIONS]; 
    int transactionCount = 0; 
public:
    BankAccount(const std::string& accNumber, double initialBalance)
        : accountNumber(accNumber), balance(initialBalance) {}

    virtual ~BankAccount() {}
    void deposit(double amount) {
        if (amount > 0) {
            balance += amount;
            recordTransaction("Deposited: " + std::to_string(amount));
        } else {
            std::cout << "Deposit amount must be positive." << std::endl;
        }
    }
    virtual void withdraw(double amount) {
        if (amount <= balance) {
            balance -= amount;
            recordTransaction("Withdrew: " + std::to_string(amount));
        } else {
            std::cout << "Insufficient balance!" << std::endl;
        }
    }
    void recordTransaction(const std::string& transaction) {
        if (transactionCount < MAX_TRANSACTIONS) {
            transactionHistory[transactionCount++] = transaction;
        } else {
            std::cout << "Transaction history full. Unable to record more transactions." << std::endl;
        }
    }
    void undoTransaction() {
        if (transactionCount > 0) {
            --transactionCount;  
            std::cout << "Last transaction undone." << std::endl;
        } else {
            std::cout << "No transactions to undo." << std::endl;
        }
    }
    virtual void displayAccountDetails() const {
        std::cout << "Account Number: " << accountNumber << std::endl;
        std::cout << "Balance: $" << balance << std::endl;
        std::cout << "Transaction History: " << std::endl;
        for (int i = 0; i < transactionCount; ++i) {
            std::cout << transactionHistory[i] << std::endl;
        }
    }
};
class SavingsAccount : public BankAccount {
private:
    double interestRate;  

public:
    SavingsAccount(const std::string& accNumber, double initialBalance, double rate)
        : BankAccount(accNumber, initialBalance), interestRate(rate) {}
    void applyInterest() {
        double interest = balance * interestRate / 100;
        balance += interest;
        recordTransaction("Interest Applied: " + std::to_string(interest));
    }
    void withdraw(double amount) override {
        if (amount <= balance) {
            balance -= amount;
            recordTransaction("Withdrew: " + std::to_string(amount));
        } else {
            std::cout << "Insufficient funds in savings account!" << std::endl;
        }
    }
    void displayAccountDetails() const override {
        BankAccount::displayAccountDetails();
        std::cout << "Interest Rate: " << interestRate << "%" << std::endl;
    }
};
class CurrentAccount : public BankAccount {
private:
    double overdraftLimit;  

public:
    CurrentAccount(const std::string& accNumber, double initialBalance, double limit)
        : BankAccount(accNumber, initialBalance), overdraftLimit(limit) {}
    void withdraw(double amount) override {
        if (amount <= (balance + overdraftLimit)) {
            balance -= amount;
            recordTransaction("Withdrew: " + std::to_string(amount));
        } else {
            std::cout << "Exceeds overdraft limit!" << std::endl;
        }
    }
    void displayAccountDetails() const override {
        BankAccount::displayAccountDetails();
        std::cout << "Overdraft Limit: $" << overdraftLimit << std::endl;
    }
};
int main() {
    SavingsAccount savings("SA12345", 1000.0, 5.0);  
    CurrentAccount current("CA12345", 500.0, 200.0); 
    std::cout << "Initial Savings Account Details:" << std::endl;
    savings.displayAccountDetails();
    std::cout << "\nDepositing $200 into Savings Account..." << std::endl;
    savings.deposit(200.0);
    std::cout << "\nWithdrawing $150 from Savings Account..." << std::endl;
    savings.withdraw(150.0);
    std::cout << "\nApplying interest to Savings Account..." << std::endl;
    savings.applyInterest();
    std::cout << "\nCurrent Savings Account Details:" << std::endl;
    savings.displayAccountDetails();
    std::cout << "\nUndoing last transaction on Savings Account..." << std::endl;
    savings.undoTransaction();
    std::cout << "\nInitial Current Account Details:" << std::endl;
    current.displayAccountDetails();
    std::cout << "\nDepositing $100 into Current Account..." << std::endl;
    current.deposit(100.0);
    std::cout << "\nWithdrawing $600 from Current Account (including overdraft)..." << std::endl;
    current.withdraw(600.0);
    std::cout << "\nCurrent Current Account Details:" << std::endl;
    current.displayAccountDetails();
    return 0;
}
