#include <iostream>
#include <iomanip>
#include <string>
using namespace std;

class Student {
private:
    int rollNumber;
    string name;
    float marks[3];
    float average;

public:
    Student() {
        rollNumber = 0;
        name = "Unknown";
        marks[0] = marks[1] = marks[2] = 0.0;
        average = 0.0;
    }

    Student(int r, string n, float m1, float m2, float m3) {
        rollNumber = r;
        name = n;
        marks[0] = m1;
        marks[1] = m2;
        marks[2] = m3;
        calculateAverage();
    }

    void inputDetails() {
        cout << "Enter Roll Number: ";
        cin >> rollNumber;
        cin.ignore();  // Clear input buffer
        cout << "Enter Name: ";
        getline(cin, name);
        cout << "Enter marks for 3 subjects:\n";
        for (int i = 0; i < 3; i++) {
            cout << "Subject " << i + 1 << ": ";
            cin >> marks[i];
        }
        calculateAverage();
    }

    void calculateAverage() {
        average = (marks[0] + marks[1] + marks[2]) / 3;
    }

    void displayDetails() const {
        cout << fixed << setprecision(2); 
        cout << "Roll Number: " << rollNumber << endl;
        cout << "Name: " << name << endl;
        cout << "Marks: " << marks[0] << ", " << marks[1] << ", " << marks[2] << endl;
        cout << "Average Marks: " << average << endl;
        cout << "-----------------------------" << endl;
    }
};

int main() {
    const int totalStudents = 3;
    Student students[totalStudents] = {
        Student(),  
        Student(101, "Happy", 85.5, 90.0, 78.5), 
        Student(102, "Marmik", 70.0, 68.5, 75.0)     
    };

    cout << "Enter details for student 1 (default initialized):" << endl;
    students[0].inputDetails();

    cout << "\n=== Student Records ===\n";
    for (int i = 0; i < totalStudents; i++) {
        students[i].displayDetails();
    }

    return 0;
}
